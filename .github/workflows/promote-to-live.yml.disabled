name: Promote Image to Live

on:
  workflow_dispatch:
    inputs:
      target_branch:
        description: 'Branch to promote (latest, latest-wolfi, hardened, hardened-wolfi)'
        required: true
        type: choice
        options:
          - latest
          - latest-wolfi
          - hardened
          - hardened-wolfi

jobs:
  promote:
    runs-on: ubuntu-latest
    environment: docker-build
    steps:
      - name: Login to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - name: Promote Multi-Arch Image to Live
        run: |
          # Use buildx imagetools to point the "Live" tag to the "Auto" manifest list
          docker buildx imagetools create \
            -t andrianey/adguardhomedotdoh:${{ github.event.inputs.target_branch }} \
            andrianey/adguardhomedotdoh:${{ github.event.inputs.target_branch }}-auto
      - name: Delete Auto Tag from Docker Hub
        run: |
          # 1. Login to Docker Hub API to get a JWT token
          TOKEN=$(curl -s -H "Content-Type: application/json" \
            -X POST \
            -d '{"username": "${{ secrets.DOCKERHUB_USERNAME }}", "password": "${{ secrets.DOCKERHUB_TOKEN }}"}' \
            https://hub.docker.com/v2/users/login/ | jq -r .token)

          # 2. Delete the -auto tag
          # Replace 'andrianey/adguardhomedotdoh' with your repo if it changes
          curl -i -X DELETE \
            -H "Authorization: JWT ${TOKEN}" \
            https://hub.docker.com/v2/repositories/andrianey/adguardhomedotdoh/tags/${{ github.event.inputs.target_branch }}-auto
